{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "typeRoots": [
      ".openjs-types"
    ],
    "checkJs": false,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "**/*.js",
    ".openjs-types/**/*.d.ts"
  ],
